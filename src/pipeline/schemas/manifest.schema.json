{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cloud-pricing/cloud-pricing-data-retrieval/contracts/manifest/1.1",
  "title": "Snapshot Manifest",
  "description": "Authoritative description of one revision of a pricing snapshot. Location: <root>/<provider>/manifests/<snapshot_date>/manifest.json (current) and <root>/<provider>/manifests/<snapshot_date>/revisions/<NNNN>.json (immutable history). Version 1.1 (feature 004) relaxes location and table-name patterns and adds optional fields for Azure and GCP; AWS manifests are otherwise unchanged. This repo is authoritative; cloud-pricing-app consumes it. Consumers MUST reject a manifest whose manifest_version MAJOR or any table schema_version they do not support, MUST find data files only through this document (never by listing directories), and MUST skip manifests whose status is not 'succeeded' unless they explicitly handle partial data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "provider",
    "snapshot_date",
    "run_id",
    "revision",
    "previous_revision",
    "created_at",
    "origin",
    "status",
    "regions",
    "run",
    "raw",
    "tables",
    "purged"
  ],
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Contract version MAJOR.MINOR. MINOR bumps only add optional fields or relax patterns. Writers emit 1.1 from feature 004."
    },
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9]+$",
      "examples": [
        "aws",
        "azure",
        "gcp"
      ]
    },
    "snapshot_date": {
      "type": "string",
      "format": "date"
    },
    "run_id": {
      "$ref": "#/$defs/run_id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "origin": {
      "enum": [
        "pipeline",
        "backfill"
      ]
    },
    "status": {
      "enum": [
        "succeeded",
        "partial",
        "failed",
        "purged"
      ]
    },
    "regions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "succeeded",
        "failed"
      ],
      "properties": {
        "requested": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "succeeded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/region"
          },
          "uniqueItems": true
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region",
              "reason",
              "attempts"
            ],
            "properties": {
              "region": {
                "$ref": "#/$defs/region"
              },
              "reason": {
                "type": "string",
                "maxLength": 500
              },
              "attempts": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger",
        "mode",
        "host",
        "started_at",
        "ended_at",
        "pipeline_version",
        "region_results"
      ],
      "properties": {
        "trigger": {
          "enum": [
            "scheduled",
            "manual",
            "backfill"
          ]
        },
        "mode": {
          "enum": [
            "full",
            "regions",
            "transform-only",
            "backfill",
            "retention-purge"
          ]
        },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "description": "Where the run executed: 'aws-ecs' for Fargate, else PIPELINE_HOST_LABEL (e.g. 'home-server'). Informational only; consumers MUST NOT change behavior based on it (FR-056)."
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ended_at": {
          "$ref": "#/$defs/timestamp"
        },
        "pipeline_version": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "git_sha",
            "image_tag"
          ],
          "properties": {
            "git_sha": {
              "type": "string"
            },
            "image_tag": {
              "type": "string"
            }
          }
        },
        "region_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "region",
              "outcome",
              "attempts"
            ],
            "properties": {
              "region": {
                "$ref": "#/$defs/region"
              },
              "outcome": {
                "enum": [
                  "succeeded",
                  "failed",
                  "skipped"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 500
              },
              "attempts": {
                "type": "integer",
                "minimum": 0
              },
              "services_downloaded": {
                "type": "integer",
                "minimum": 0
              },
              "services_without_price_list": {
                "type": "integer",
                "minimum": 0
              },
              "unparseable_prices": {
                "type": "integer",
                "minimum": 0,
                "description": "Price values present in the source but not numeric; stored as null, never estimated (constitution Principle I)."
              },
              "items_received": {
                "type": "integer",
                "minimum": 0,
                "description": "Items (Azure) or SKUs (GCP) the source returned for, or filed under, this location."
              },
              "duplicates_removed": {
                "type": "integer",
                "minimum": 0,
                "description": "Byte-identical items seen more than once (pagination overlap); kept once."
              },
              "unlocated_rows": {
                "type": "integer",
                "minimum": 0,
                "description": "Rows filed under 'global' because the source gave no location."
              },
              "throttled_responses": {
                "type": "integer",
                "minimum": 0,
                "description": "Throttling responses received while downloading this location (Azure)."
              },
              "requests_made": {
                "type": "integer",
                "minimum": 0,
                "description": "Requests sent to the source for this location, including retries (Azure)."
              }
            }
          }
        }
      }
    },
    "raw": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "location",
              "file_count",
              "bytes",
              "stored_at",
              "purge_after"
            ],
            "properties": {
              "location": {
                "type": "string",
                "pattern": "^[a-z0-9]+/raw/[0-9]{4}-[0-9]{2}-[0-9]{2}/[a-z0-9]+(-[a-z0-9]+)*/[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}/$"
              },
              "file_count": {
                "type": "integer",
                "minimum": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "stored_at": {
                "$ref": "#/$defs/timestamp"
              },
              "purge_after": {
                "type": "string",
                "format": "date"
              }
            }
          },
          "description": "Keyed by raw unit: the location for AWS and Azure, 'catalog' for GCP."
        }
      ]
    },
    "tables": {
      "type": "object",
      "description": "Keyed by the provider's own table names (contracts/storage-layout.md: aws = service_dim, product_dim, product_attribute, region_dim, price_fact; azure = price_item, price_item_savings_plan; gcp = service, sku, sku_price, sku_price_tier). Consumers MUST reject unknown table names for a provider they support.",
      "propertyNames": {
        "pattern": "^[a-z][a-z_]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/table"
      }
    },
    "purged": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "purged_at",
            "reason"
          ],
          "properties": {
            "purged_at": {
              "$ref": "#/$defs/timestamp"
            },
            "reason": {
              "enum": [
                "retention-thinning"
              ]
            }
          }
        }
      ]
    },
    "excluded_price_types": {
      "description": "Optional (Azure). Source price types deliberately not downloaded for this snapshot, e.g. ['DevTestConsumption'] when INCLUDE_AZURE_DEVTEST_PRICES=false (FR-035). Absent or empty: nothing was excluded.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "catalog": {
      "description": "Optional (GCP). Counters for the single catalog-wide download (FR-031, FR-034). The catalog either downloads completely or the snapshot fails, so there is no per-unit outcome.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "api_version",
            "requests_made",
            "skus_received"
          ],
          "properties": {
            "api_version": {
              "type": "string",
              "minLength": 1,
              "description": "Catalog API version used, e.g. 'v2beta'."
            },
            "requests_made": {
              "type": "integer",
              "minimum": 0,
              "description": "Requests sent for the whole catalog, retries included."
            },
            "throttled_responses": {
              "type": "integer",
              "minimum": 0,
              "description": "Throttling responses received."
            },
            "skus_received": {
              "type": "integer",
              "minimum": 0,
              "description": "Distinct SKUs the source returned."
            },
            "skus_out_of_scope": {
              "type": "integer",
              "minimum": 0,
              "description": "SKUs of services outside the configured business entities (e.g. Maps)."
            },
            "skus_unconfigured_locations": {
              "type": "integer",
              "minimum": 0,
              "description": "In-scope SKUs whose locations are all unconfigured; not stored for this snapshot."
            },
            "skus_unlocated": {
              "type": "integer",
              "minimum": 0,
              "description": "SKUs with no location in the source; filed under 'global'."
            },
            "skus_without_price": {
              "type": "integer",
              "minimum": 0,
              "description": "SKUs with no price entry; stored with no price rows."
            },
            "prices_without_sku": {
              "type": "integer",
              "minimum": 0,
              "description": "Price entries whose SKU was not in the SKU list; not stored."
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "purged"
          }
        }
      },
      "then": {
        "properties": {
          "purged": {
            "type": "object"
          },
          "tables": {
            "maxProperties": 0
          }
        }
      },
      "else": {
        "properties": {
          "purged": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        }
      },
      "then": {
        "properties": {
          "regions": {
            "properties": {
              "failed": {
                "maxItems": 0
              }
            }
          },
          "tables": {
            "minProperties": 1
          }
        }
      },
      "description": "A succeeded snapshot has no failed location. Each provider's full table list is checked in code against its ProviderSpec (minProperties can't vary by provider in this schema)."
    },
    {
      "if": {
        "properties": {
          "origin": {
            "const": "backfill"
          }
        }
      },
      "then": {
        "properties": {
          "raw": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "A location: a region (us-east-1, eastus, us-east1), a multi-region location (us, nam4, north-america) or 'global' (feature 004, FR-013). Name kept as 'region' for 1.0 compatibility."
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$"
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "row_count",
        "regions"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "regions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/region"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "written_by_run",
              "row_count",
              "files"
            ],
            "properties": {
              "written_by_run": {
                "$ref": "#/$defs/run_id"
              },
              "row_count": {
                "type": "integer",
                "minimum": 0
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "bytes",
                    "sha256",
                    "row_count"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+/parquet/[a-z_]+/snapshot_date=[0-9]{4}-[0-9]{2}-[0-9]{2}/region=[a-z0-9]+(-[a-z0-9]+)*/part-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}(-[0-9]+)?\\.parquet$"
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "row_count": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$comment": "The example below is abbreviated to one table and two regions for readability; a real succeeded manifest lists all five tables (see allOf rule).",
  "examples": [
    {
      "manifest_version": "1.1",
      "provider": "aws",
      "snapshot_date": "2026-10-05",
      "run_id": "20261005T141210Z-9c41e2",
      "revision": 2,
      "previous_revision": 1,
      "created_at": "2026-10-05T14:19:02Z",
      "origin": "pipeline",
      "status": "succeeded",
      "regions": {
        "requested": [
          "eu-west-1",
          "us-east-1"
        ],
        "succeeded": [
          "eu-west-1",
          "us-east-1"
        ],
        "failed": []
      },
      "run": {
        "trigger": "manual",
        "mode": "regions",
        "host": "aws-ecs",
        "started_at": "2026-10-05T14:12:10Z",
        "ended_at": "2026-10-05T14:19:40Z",
