{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cloud-pricing/cloud-pricing-data-retrieval/contracts/latest/1.0",
  "title": "Latest Snapshot Pointer",
  "description": "Location: <root>/<provider>/manifests/latest.json. Names the newest snapshot date whose current manifest has status 'succeeded'. Written only after that manifest, via compare-and-swap; its snapshot_date never moves backwards. Consumers read manifest_path and accept the manifest if its snapshot_date matches, its status is 'succeeded', and its revision is >= this pointer's revision (a later same-date revision can only add or replace data, never regress).",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "provider", "snapshot_date", "revision", "run_id", "manifest_path", "updated_at"],
  "properties": {
    "manifest_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "provider": { "type": "string", "pattern": "^[a-z0-9]+$" },
    "snapshot_date": { "type": "string", "format": "date" },
    "revision": { "type": "integer", "minimum": 1 },
    "run_id": { "type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$" },
    "manifest_path": { "type": "string", "pattern": "^[a-z0-9]+/manifests/[0-9]{4}-[0-9]{2}-[0-9]{2}/manifest\\.json$" },
    "updated_at": { "type": "string", "format": "date-time", "pattern": "Z$" }
  },
  "examples": [
    {
      "manifest_version": "1.0",
      "provider": "aws",
      "snapshot_date": "2026-10-05",
      "revision": 2,
      "run_id": "20261005T141210Z-9c41e2",
      "manifest_path": "aws/manifests/2026-10-05/manifest.json",
      "updated_at": "2026-10-05T14:19:03Z"
    }
  ]
}
